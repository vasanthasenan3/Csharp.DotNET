<Window x:Class="DailyDairyApplication.Register"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DailyDairyApplication"
        mc:Ignorable="d"
        Title="Register" Background="#0F172A" Height="800" Width="590">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="BorderBrush" Value="Gold"></Setter>
            <Setter Property="BorderThickness"  Value="3"></Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="1,1" EndPoint="0,0">
                <GradientStop Color="CadetBlue" Offset="0"></GradientStop>
                <GradientStop Color="White" Offset="1"></GradientStop>
            </LinearGradientBrush>
        </Grid.Background>
        <Border Width="500"
            MaxHeight="700"
            CornerRadius="35"
            Background="#1E293B"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Background>
                    <LinearGradientBrush StartPoint="1,1" EndPoint="0,0">
                        <GradientStop Color="CadetBlue" Offset="0"></GradientStop>
                        <GradientStop Color="White" Offset="1"></GradientStop>
                    </LinearGradientBrush>
                </ScrollViewer.Background>
                <StackPanel Margin="40">

                    <TextBlock Text="✨ Create Account"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="Black"
                           HorizontalAlignment="Center"/>

                    <TextBlock Text="Join Daily Diary Today"
                           FontSize="16"
                           Foreground="Black"
                           HorizontalAlignment="Center"
                           Margin="0,5,0,25"/>

                    <TextBlock Text="Full Name"
                           Foreground="Black"/>

                    <TextBox Name="txtname"
                         Height="45"
                         Margin="0,5,0,15"
                         FontSize="16"/>

                    <TextBlock Text="Username"
                           Foreground="Black"/>

                    <TextBox Name="txtusername"
                         Height="45"
                         Margin="0,5,0,15"
                         FontSize="16"/>

                    <TextBlock Text="Email Address"
                           Foreground="Black"/>

                    <TextBox Name="txtemail"
                         Height="45"
                         Margin="0,5,0,15"
                         FontSize="16"/>

                    <TextBlock Text="Password"
                           Foreground="Black"/>

                    <PasswordBox Name="pwpassword"
                             Height="45"
                             BorderBrush="Gold"
                             BorderThickness="3"
                             Margin="0,5,0,15"
                             FontSize="16"/>

                    <TextBlock Text="Confirm Password"
                           Foreground="Black"/>

                    <PasswordBox Name="pwconfirmpassword"
                             Height="45"
                             BorderBrush="Gold"
                             BorderThickness="3"
                             Margin="0,5,0,25"
                             FontSize="16"/>

                    <Button Name="btnreg"
                        Content="🚀 REGISTER"
                        Height="50"
                        Click="btnreg_Click"
                        FontSize="18"
                        FontWeight="Bold"
                        Background="#10B981"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"/>
                    <Button Content="Already Have an Account? Login"
                    Name="btnregs"
                    Click="btnregs_Click_1"
Height="50"
FontWeight="Bold"
                    BorderBrush="Transparent"
FontSize="18"
Margin="0,0,0,0"
Background="Transparent"
Foreground="Blue"/>

                    <TextBlock Text="Search"
                           Foreground="White"
                           Margin="0,25,0,5"/>

                    <TextBox Name="txtsearch"
                         Height="35"
                         BorderBrush="Black"
                         Margin="0,0,0,15"
                         FontSize="16"/>

                    <Button Name="btnsearch"
                        Content="Search"
                        Height="45"
                        Click="btnsearch_Click"
                        FontSize="16"
                        FontWeight="Bold"
                        Background="#10B981"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"/>

                    <ListView x:Name="lstdata"
                          Margin="0,20,0,0"
                          Height="220"
                          BorderBrush="Black"
                          BorderThickness="2">

                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Name"
                                            Width="130"
                                            DisplayMemberBinding="{Binding Name}"/>

                                <GridViewColumn Header="Username"
                                            Width="120"
                                            DisplayMemberBinding="{Binding Username}"/>

                                <GridViewColumn Header="Email"
                                            Width="180"
                                            DisplayMemberBinding="{Binding Email}"/>
                            </GridView>
                        </ListView.View>

                    </ListView>

                </StackPanel>

            </ScrollViewer>

        </Border>

    </Grid>
</Window>
