<Window x:Class="DailyDairyApplication.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DailyDairyApplication"
        mc:Ignorable="d"
        Title="Login" Height="650" Width="500">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="1,1" EndPoint="0,0">
                <GradientStop Color="CadetBlue" Offset="0"></GradientStop>
                <GradientStop Color="White" Offset="1"></GradientStop>
            </LinearGradientBrush>
        </Grid.Background>
        <Border Width="450"
            Height="565"
            CornerRadius="25"
        
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
            <Border.Background>
                <LinearGradientBrush StartPoint="1,1" EndPoint="0,0">
                    <GradientStop Color="CadetBlue" Offset="0"></GradientStop>
                    <GradientStop Color="White" Offset="1"></GradientStop>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel Margin="40">

                <TextBlock Text="📖 Daily Diary"
                       FontSize="32"
                           
                         
                       FontWeight="Bold"
                       Foreground="Black"
                       HorizontalAlignment="Center"/>

                <TextBlock Text="Welcome Back!"
                       FontSize="20"
                       Margin="20,10,0,30"
                       Foreground="Black"
                       HorizontalAlignment="Center"/>
                <TextBlock Text="Username"
        FontSize="22"
        Margin="0,0,265,0"
        Foreground="Black"
        HorizontalAlignment="Center"/>

                <TextBox Height="45"
                         Name="txtusername"
                     Margin="0,10"
                     FontSize="16"/>
                <TextBlock Text="Password"
FontSize="22"
Margin="0,0,265,0"
Foreground="Black"
HorizontalAlignment="Center"/>

                <PasswordBox Height="45"
                             Name="pwpassword"
                         Margin="0,10"/>

                <CheckBox Content="Remember Me"
                      Foreground="Black"
                      Margin="0,10"/>



                <Button Content="LOGIN"
         Name="btnlogin"
         Click="btnlogin_Click"
     Height="50"
     FontWeight="Bold"
     FontSize="18"
     Margin="0,20,0,0"
     Background="Blue"
     Foreground="White"/>


                <Button Content="New user? Register"
                    Name="btnregs"
                    Click="btnregs_Click"
Height="50"

                    BorderBrush="Transparent"
FontSize="18"
Margin="0,0,0,0"
Background="Transparent"
Foreground="Blue"/>


            </StackPanel>

        </Border>
    </Grid>
</Window>
