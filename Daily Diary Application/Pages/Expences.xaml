<Page x:Class="DailyDairyApplication.Expences"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:DailyDairyApplication"
      mc:Ignorable="d" 
      d:DesignHeight="650" d:DesignWidth="700"
      Title="Expences">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="1,1" EndPoint="0,0">
                <GradientStop Color="CadetBlue" Offset="0"></GradientStop>
                <GradientStop Color="White" Offset="1"></GradientStop>
            </LinearGradientBrush>
        </Grid.Background>
        
        <Border Width="650"
            Padding="20"
            CornerRadius="15"
   
                
            BorderBrush="#D9D9D9"
            BorderThickness="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
            <Border.Background>

                <LinearGradientBrush StartPoint="1,1" EndPoint="0,0">
                    <GradientStop Color="CadetBlue" Offset="0"></GradientStop>
                    <GradientStop Color="White" Offset="1"></GradientStop>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel>

                <TextBlock Text="💰 My Expenses"
                           Foreground="Black"
                       FontSize="28"
                       FontWeight="Bold"
                       Margin="0,0,0,20"/>

                <!-- Expense Name -->
                <TextBlock Text="Expense Name"
                           Foreground="Black"
                       FontWeight="Bold"/>

                <Border Margin="0,5,0,15"
                    CornerRadius="100"
                    BorderBrush="Black"
                    BorderThickness="1">

                    <TextBox x:Name="txtExpense"
                         Height="40"
                           BorderBrush="Black"
                         BorderThickness="2"
                         Padding="10"/>
                </Border>

                <!-- Amount -->
                <TextBlock Text="Amount"
                           Foreground="Black"
                       FontWeight="Bold"/>

                <Border Margin="0,5,0,15"
                    CornerRadius="100"
                    BorderBrush="Black"
                    BorderThickness="1">

                    <TextBox x:Name="txtAmount"
                         Height="40"
                             BorderBrush="Black"
                         BorderThickness="2"
                         Padding="10"/>
                </Border>

                <!-- Add Button -->
                <Border CornerRadius="10"
                    Margin="0,0,0,20">

                    <Button Content="➕ Add Expense"
                        Height="45"
                      Click="Button_Click"
                            BorderBrush="Black"
                            BorderThickness="2"
                        Background="Transparent"
                        Foreground="Black"
                        FontWeight="Bold"
                       />
                </Border>

                <!-- Expense List -->
                <Border Height="220"
                    BorderBrush="Gold"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="10">

                    <ListBox x:Name="lstExpenses"
                             BorderBrush="Gold"
                         BorderThickness="2"/>
                </Border>

                <!-- Total -->
                <TextBlock x:Name="txtTotal"
                       Margin="0,20,0,0"
                       FontSize="18"
                       FontWeight="Bold"
                       Text="Total Expense : ₹0"/>

            </StackPanel>

        </Border>

    </Grid>
</Page>
