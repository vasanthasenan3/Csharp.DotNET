<Page x:Class="DailyDairyApplication.Profilepage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:DailyDairyApplication"
      mc:Ignorable="d" 
      d:DesignHeight="650" d:DesignWidth="800"
      Title="Profilepage">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="1,1" EndPoint="0,0">
                <GradientStop Color="CadetBlue" Offset="0"></GradientStop>
                <GradientStop Color="White" Offset="1"></GradientStop>
            </LinearGradientBrush>
        </Grid.Background>
        <Border Width="450"
            Height="650"
         
            CornerRadius="20"
            Padding="20"
                
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
            <Border.Background>
                <LinearGradientBrush StartPoint="1,1" EndPoint="0,0">
                    <GradientStop Color="CadetBlue" Offset="0"></GradientStop>
                    <GradientStop Color="White" Offset="1"></GradientStop>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel HorizontalAlignment="Center">

                <!-- Profile -->
                <Border Width="150"
                    Height="150"
                    CornerRadius="75"
                    BorderBrush="White"
                    BorderThickness="4">

                    <Grid>
                        <Ellipse Fill="Transparent"/>

                        <TextBlock Text="👤"
                               FontSize="60"
                               Foreground="white"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                        <Ellipse>
                            <Ellipse.Fill>
                                <ImageBrush x:Name="imgBrush" Stretch="UniformToFill"/>
                            </Ellipse.Fill>
                        </Ellipse>

                    </Grid>

                </Border>

                <TextBlock Text="Profile Summary"
                       FontSize="28"
                           Foreground="Black"
                       FontWeight="Bold"
                       Margin="0,10,0,20"
                       HorizontalAlignment="Center"/>

                <!-- Upload Button -->
                <Border CornerRadius="20"
                        BorderBrush="Black"
                        BorderThickness="2"
                    Height="39" Width="200" Padding="2">
                    <!--<Border.Background>
                        <LinearGradientBrush StartPoint="1,1" EndPoint="0,0">
                            <GradientStop Color="Black" Offset="0"></GradientStop>
                            <GradientStop Color="WhiteSmoke" Offset="1"></GradientStop>
                        </LinearGradientBrush>
                    </Border.Background>-->
                    <Button Content="📷 Upload Photo"
                            Click="Button_Click"
     Width="180"
     Height="30"
                           
     Foreground="Black"
     Background="Transparent"
     BorderThickness="0"
     FontWeight="Bold"/>
                </Border>


                <!-- About -->
                <TextBlock Text="About Me"
                       FontSize="22"
                       FontWeight="Bold"
                           Foreground="Black"
                       Margin="0,25,0,10"/>

                <TextBox Width="350"
                         Name="txtabout"
                     Height="180"
                         BorderBrush="Black"
                         BorderThickness="2"
                     FontSize="16"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalContentAlignment="Top"
                     Text="Write Here..."/>

                <!-- Save Button -->
                <Border CornerRadius="20"
                       
                        BorderThickness="2"
                        BorderBrush="Black"
               Height="39" Width="200" Margin="10" Padding="2">
                    <!--<Border.Background>
                        <LinearGradientBrush StartPoint="1,1" EndPoint="0,0">
                            <GradientStop Color="Blue" Offset="0"></GradientStop>
                            <GradientStop Color="Black" Offset="1"></GradientStop>
                        </LinearGradientBrush>
                    </Border.Background>-->
                    <Button Content="💾 Save Changes"
Width="180"
Height="30"   Foreground="Black"
                            Name="btnsavechanges"
Background="Transparent"
          Click="btnsavechanges_Click"               
BorderThickness="0"
FontWeight="Bold"/>
                </Border>
            </StackPanel>

        </Border>

    </Grid>
</Page>
